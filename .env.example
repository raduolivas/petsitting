# Copy to .env and fill in values
FLASK_ENV=development

# Required in production — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# SQLite (dev default) or PostgreSQL
# DATABASE_URL=sqlite:///instance/pawbnb.db
# DATABASE_URL=postgresql+psycopg2://pawbnb:pawbnb@localhost:5432/pawbnb

# Stripe (optional for demo mode)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Set to 1 only if you must use SQLite in production (not recommended)
ALLOW_SQLITE_IN_PROD=0
FORCE_HTTPS=0
PORT=5000
