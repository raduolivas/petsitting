FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Database (SQLite default in dev)
# DATABASE_URL=sqlite:///instance/pawbnb.db
# DATABASE_URL=postgresql+psycopg2://pawbnb:pawbnb@localhost:5432/pawbnb

# Rate limiting — use Redis in production
RATELIMIT_STORAGE_URI=memory://
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# Stripe (test keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur

# Email (leave empty to print emails to console)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Pawbnb <noreply@pawbnb.local>
MAIL_SUPPRESS_SEND=1

ALLOW_SQLITE_IN_PROD=0
FORCE_HTTPS=0
PORT=5000
